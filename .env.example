# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LINE Platform Configuration
NEXT_PUBLIC_LIFF_ID=your-line-liff-id
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
# LINE User ID ของแอดมิน (นายเอกพงศ์) เพื่อรับการแจ้งเตือนทันทีที่มีเคสใหม่
ADMIN_LINE_USER_ID=your-admin-line-user-id

# Application URL (เช่น https://smkcc-it-helpdesk.vercel.app)
NEXT_PUBLIC_APP_URL=https://smkcc-it-helpdesk.vercel.app

# Admin Authentication (Simple Credentials or Supabase Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-secure-password
ADMIN_SECRET_TOKEN=a-random-secret-token-for-admin-session
